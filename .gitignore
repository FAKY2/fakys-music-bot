# images in emojis/ are yours to commit.
emojis/.discord-cache/
emojis/downloads/

# Lavalink server (the jar is ~96MB, download it yourself)
lavalink/Lavalink.jar
lavalink/plugins/
lavalink/logs/
lavalink/truststore.jks
lavalink/lavalink.log
